# Server-side origin for all requests from Server Actions and Server Components.
GATEWAY_API_URL=http://localhost:8000

# Public origin of this web app, used for canonical and Open Graph URLs.
# Defaults to http://localhost:3000 when unset or not an absolute http(s) URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional names for authentication and tenant cookies.
AUTH_COOKIE_NAME=auth_token
TENANT_ID_COOKIE_NAME=tenant_id
